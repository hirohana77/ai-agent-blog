{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-agent-blog",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": ".",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-agent-blog-db",
      "database_id": "local-fallback"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "ai-agent-blog-media"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
